binds {
    Mod+Space hotkey-overlay-title="Shell | Launcher" { spawn "dotshell" "ipc" "call" "launcher" "toggle"; }
    Mod+V hotkey-overlay-title="Shell | Clipboard" { spawn "dotshell" "ipc" "call" "launcher" "clipboard"; }
    Super+X hotkey-overlay-title="Shell | Power menu" { spawn "dotshell" "ipc" "call" "panels" "power"; }
    Mod+N hotkey-overlay-title="Shell | Notification center" { spawn "dotshell" "ipc" "call" "notifications" "toggle"; }
    Mod+Slash hotkey-overlay-title="Shell | Keybinds" { spawn "dotshell" "ipc" "call" "cheatsheet" "toggle"; }
    Mod+Comma hotkey-overlay-title="Shell | Settings" { spawn "dotshell" "ipc" "call" "settings" "toggle"; }
    Mod+I hotkey-overlay-title="Shell | Settings" { spawn "dotshell" "ipc" "call" "settings" "toggle"; }

    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Media | Volume up" { spawn "dotshell" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Media | Volume down" { spawn "dotshell" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Media | Mute" { spawn "dotshell" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Media | Mute microphone" { spawn "dotshell" "ipc" "call" "audio" "micmute"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Media | Play or pause" { spawn "dotshell" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Media | Play or pause" { spawn "dotshell" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Media | Previous track" { spawn "dotshell" "ipc" "call" "mpris" "previous"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Media | Next track" { spawn "dotshell" "ipc" "call" "mpris" "next"; }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Media | Player volume up" { spawn "dotshell" "ipc" "call" "mpris" "increment" "3"; }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Media | Player volume down" { spawn "dotshell" "ipc" "call" "mpris" "decrement" "3"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Media | Brightness up" { spawn "dotshell" "ipc" "call" "brightness" "increment" "5"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Media | Brightness down" { spawn "dotshell" "ipc" "call" "brightness" "decrement" "5"; }
}
